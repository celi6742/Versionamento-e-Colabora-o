<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Alice • Portfólio</title>

  <!-- Novas Fontes: Playfair Display (títulos elegantes) e Nunito (texto fofo e legível) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">

  <style>
    /* PALETA DE CORES: Fundo rosa bem clarinho + textos bem escuros */
    :root {
      --fundo: hwb(342 67% 11%);           /* Rosa bem clarinho e delicado */
      --cartao: hsl(0, 0%, 100%);          /* Branco puro nos cartões */
      --texto-principal: #240c1a; /* Ameixa bem escuro para leitura nítida */
      --texto-suave: #59354a;     /* Tom escuro suave para subtítulos */
      --primaria: hsl(333, 66%, 29%);        /* Rosa profundo para títulos e destaques */
      --primaria-clara: #f472b6;  /* Rosa médio para detalhes */
      --tag-fundo: #fce7f3;       /* Fundo das etiquetas */
      --tag-texto: #831843;       /* Texto escuro nas etiquetas */
      --borda: #f9d8e6;           /* Borda rosada sutil */
    }

    * {
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      font-family: 'Nunito', sans-serif;
      background-color: var(--fundo);
      color: var(--texto-principal);
      line-height: 1.65;
      min-height: 100vh;
    }

    /* Menu de navegação superior */
    nav {
      background: rgba(255, 255, 255, 0.92);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--borda);
      position: sticky;
      top: 0;
      z-index: 100;
      padding: 14px 20px;
    }

    .nav-conteudo {
      max-width: 860px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 10px;
    }

    .logo {
      font-family: 'Playfair Display', serif;
      font-weight: 700;
      font-size: 1.3rem;
      color: var(--primaria);
      text-decoration: none;
    }

    .nav-links a {
      text-decoration: none;
      color: var(--texto-principal);
      font-size: 0.92rem;
      font-weight: 600;
      margin-left: 16px;
      transition: color 0.2s;
    }

    .nav-links a:hover {
      color: var(--primaria);
    }

    /* Container principal */
    .container {
      max-width: 860px;
      margin: 36px auto;
      padding: 0 20px;
    }

    /* Cabeçalho / Perfil */
    header {
      text-align: center;
      margin-bottom: 32px;
      background: var(--cartao);
      padding: 42px 24px;
      border-radius: 24px;
      border: 1px solid var(--borda);
      box-shadow: 0 8px 24px rgba(219, 39, 119, 0.05);
    }

    .avatar {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 108px;
      height: 108px;
      border-radius: 50%;
      background: linear-gradient(135deg, #f472b6, #db2777);
      color: white;
      font-size: 44px;
      margin-bottom: 16px;
      box-shadow: 0 8px 20px rgba(219, 39, 119, 0.2);
      border: 4px solid #fff;
      outline: 2px solid var(--borda);
      overflow: hidden;
    }

    .avatar img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    h1, h2 {
      font-family: 'Playfair Display', serif;
      margin-top: 0;
    }

    h3 {
      font-family: 'Nunito', sans-serif;
      font-weight: 700;
      margin-top: 0;
    }

    h1 {
      font-size: 2.2rem;
      margin-bottom: 6px;
      color: var(--texto-principal);
    }

    .subtitulo {
      margin: 0 auto 14px;
      color: var(--texto-suave);
      font-size: 1.08rem;
      font-weight: 600;
    }

    .badge-status {
      display: inline-block;
      background-color: var(--tag-fundo);
      color: var(--tag-texto);
      font-size: 0.88rem;
      font-weight: 700;
      padding: 6px 16px;
      border-radius: 99px;
      border: 1px solid var(--borda);
    }

    /* Cartões das seções */
    section {
      background-color: var(--cartao);
      padding: 30px 34px;
      margin-bottom: 24px;
      border-radius: 20px;
      border: 1px solid var(--borda);
      box-shadow: 0 4px 18px rgba(219, 39, 119, 0.04);
    }

    section h2 {
      font-size: 1.5rem;
      color: var(--primaria);
      margin-bottom: 18px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Grade de informações rápidas */
    .info-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
      margin-top: 20px;
      padding-top: 20px;
      border-top: 1px dashed var(--borda);
      font-size: 0.95rem;
    }

    .info-item strong {
      color: var(--primaria);
      display: block;
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.6px;
      margin-bottom: 2px;
    }

    /* Habilidades */
    .habilidades-grupo {
      margin-bottom: 18px;
    }

    .habilidades-grupo:last-child {
      margin-bottom: 0;
    }

    .habilidades-titulo {
      font-size: 0.9rem;
      font-weight: 700;
      color: var(--texto-suave);
      margin-bottom: 8px;
      display: block;
    }

    .habilidades span {
      display: inline-block;
      background-color: var(--tag-fundo);
      color: var(--tag-texto);
      padding: 7px 14px;
      margin: 4px 6px 4px 0;
      border-radius: 12px;
      font-size: 0.92rem;
      font-weight: 600;
      border: 1px solid var(--borda);
      transition: transform 0.2s, background-color 0.2s;
    }

    .habilidades span:hover {
      transform: translateY(-2px);
      background-color: #fbcfe8;
    }

    /* Formação & Certificados */
    .item-lista {
      padding-left: 16px;
      border-left: 3px solid var(--primaria-clara);
      margin-bottom: 20px;
    }

    .item-lista:last-child {
      margin-bottom: 0;
    }

    .item-lista h3 {
      margin-bottom: 2px;
      font-size: 1.08rem;
      color: var(--texto-principal);
    }

    .item-periodo {
      font-size: 0.88rem;
      color: var(--primaria);
      font-weight: 700;
      display: block;
      margin-bottom: 6px;
    }

    /* Lista de Metas / Objetivos */
    .lista-metas {
      list-style: none;
      padding: 0;
      margin: 0;
    }

    .lista-metas li {
      padding: 10px 14px;
      background-color: var(--fundo);
      border: 1px solid var(--borda);
      border-radius: 12px;
      margin-bottom: 10px;
      font-weight: 600;
    }

    .lista-metas li:last-child {
      margin-bottom: 0;
    }

    /* Grade de Projetos */
    .projetos-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
    }

    .projeto-card {
      background: var(--fundo);
      border: 1px solid var(--borda);
      border-radius: 16px;
      padding: 20px;
      transition: transform 0.2s, box-shadow 0.2s;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .projeto-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 20px rgba(219, 39, 119, 0.1);
    }

    .projeto-card h3 {
      margin-bottom: 8px;
      color: var(--texto-principal);
    }

    .projeto-card p {
      font-size: 0.94rem;
      margin-top: 0;
      color: var(--texto-suave);
    }

    .projeto-tags {
      margin: 12px 0;
    }

    .projeto-tags span {
      font-size: 0.78rem;
      background: #fff;
      color: var(--tag-texto);
      padding: 3px 9px;
      border-radius: 8px;
      border: 1px solid var(--borda);
      margin-right: 4px;
      font-weight: 700;
    }

    .link-projeto {
      font-size: 0.92rem;
      font-weight: 700;
      color: var(--primaria);
      text-decoration: none;
    }

    .link-projeto:hover {
      text-decoration: underline;
    }

    /* Cartões de Favoritos / Inspirações */
    .favoritos-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 12px;
    }

    .fav-card {
      background: var(--fundo);
      border: 1px solid var(--borda);
      border-radius: 14px;
      padding: 14px 16px;
    }

    .fav-card strong {
      display: block;
      color: var(--primaria);
      font-size: 0.85rem;
      margin-bottom: 4px;
    }

    /* Botões e Links de Contato */
    .links-contato {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-bottom: 18px;
    }

    .btn-link {
      text-decoration: none;
      background-color: var(--fundo);
      color: var(--texto-principal);
      border: 1px solid var(--borda);
      padding: 10px 16px;
      border-radius: 12px;
      font-size: 0.94rem;
      font-weight: 700;
      transition: all 0.2s;
    }

    .btn-link:hover {
      background-color: var(--tag-fundo);
      border-color: var(--primaria);
      color: var(--primaria);
    }

    button {
      background: linear-gradient(135deg, #ec4899, #db2777);
      color: white;
      border: none;
      padding: 12px 24px;
      border-radius: 12px;
      font-family: 'Nunito', sans-serif;
      font-size: 0.98rem;
      font-weight: 700;
      cursor: pointer;
      box-shadow: 0 4px 14px rgba(219, 39, 119, 0.25);
      transition: transform 0.2s, box-shadow 0.2s;
    }

    button:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 18px rgba(219, 39, 119, 0.35);
    }

    #mensagem {
      margin-top: 14px;
      font-weight: 700;
      color: var(--primaria);
      min-height: 24px;
    }

    footer {
      text-align: center;
      color: var(--texto-suave);
      font-size: 0.92rem;
      font-weight: 600;
      padding: 20px 0 40px;
    }

    /* Ajustes para celular */
    @media (max-width: 650px) {
      .nav-links { display: none; }
      section { padding: 24px 20px; }
      h1 { font-size: 1.8rem; }
    }
  </style>
</head>
